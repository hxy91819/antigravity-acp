{
  "agy-acp-steer": {
    "PreInvocation": [
      {
        "type": "command",
        "command": "bun ./steer-hook.ts pre",
        "timeout": 10
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "bun ./steer-hook.ts post",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^schedule$",
        "hooks": [
          {
            "type": "command",
            "command": "bun ./schedule-hook.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
